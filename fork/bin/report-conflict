#!/usr/bin/env bash
set -euo pipefail

base_tag="$1"
conflicts="$2"

label="fork-conflict"
title="Rebase conflict on ${base_tag}"

conflict_list() {
  tr ',' '\n' <<< "$conflicts" | sed '/^$/d; s/^/- `/; s/$/`/'
}

issue_body() {
  printf 'The `custom` branch does not rebase onto `%s`.\n\n' "$base_tag"
  printf 'Conflicting files:\n\n%s\n\n' "$(conflict_list)"
  printf 'Run `fork/bin/sync`, resolve the conflict, then run `git rebase --continue` and `git push --force-with-lease origin custom`.\n'
}

gh label create "$label" --color B60205 --description "custom does not rebase onto the latest upstream nightly" --force > /dev/null

open_issue="$(gh issue list --label "$label" --state open --json number --jq '.[0].number // empty')"

if [[ -n "$open_issue" ]]; then
  gh issue edit "$open_issue" --title "$title" --body "$(issue_body)" > /dev/null
else
  gh issue create --title "$title" --label "$label" --body "$(issue_body)" > /dev/null
fi
