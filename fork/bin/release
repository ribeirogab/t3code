#!/usr/bin/env bash
set -euo pipefail

fork_repository="${FORK_REPOSITORY:-ribeirogab/t3code}"
upstream_repository="${UPSTREAM_REPOSITORY:-pingdotgg/t3code}"
fork_branch="custom"
keep_count=20
signing_name="T3 Code Fork (ribeirogab)"
install_filters=(--filter=t3... --filter=@t3tools/web... --filter=@t3tools/desktop... --filter=@t3tools/scripts...)
required_assets=(nightly-mac.yml nightly-linux.yml '*-arm64.dmg' '*-arm64.zip' '*.AppImage' 't3-*-linux-x64.tar.gz' SHA256SUMS)

export GH_REPO="$fork_repository"
export UPSTREAM_REPOSITORY="$upstream_repository"

usage() {
  cat >&2 <<'USAGE'
Usage: fork/bin/release <command>

  sync    Rebase custom onto the latest upstream nightly and push it.
  linux   Build the Linux x64 AppImage and CLI archive in Docker, then upload them.
  mac     Build the macOS arm64 app, sign it with the fork certificate, then upload it.

linux and mac upload to the same draft release. The one that finishes second publishes it.
USAGE
  exit 1
}

log() {
  printf '\n==> %s\n' "$*" >&2
}

work_root() {
  if [[ -n "${T3CODE_RELEASE_WORK_DIR:-}" ]]; then
    printf '%s\n' "$T3CODE_RELEASE_WORK_DIR"
  elif [[ "$(uname -s)" == "Darwin" ]]; then
    printf '%s\n' "$HOME/Library/Caches/t3code-fork-release"
  else
    printf '%s\n' "${XDG_CACHE_HOME:-$HOME/.cache}/t3code-fork-release"
  fi
}

work="$(work_root)"
repo="$work/repo"

ensure_clone() {
  if [[ -d "$repo/.git" ]]; then
    return
  fi
  mkdir -p "$work"
  git clone --filter=blob:none --no-checkout "https://github.com/${fork_repository}.git" "$repo"
  git -C "$repo" sparse-checkout set --no-cone '/*' '!/.repos/'
}

checkout() {
  local ref="$1"
  ensure_clone
  git -C "$repo" fetch --no-tags origin "$ref"
  git -C "$repo" -c checkout.workers=0 checkout --quiet --force --detach FETCH_HEAD
  git -C "$repo" clean -ffdxq -e node_modules -e target
}

released_tag_for() {
  git ls-remote --tags --refs "https://github.com/${fork_repository}.git" \
    | awk -v sha="$1" '$1 == sha { sub("refs/tags/", "", $2); print $2 }' \
    | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+-nightly\.[0-9]{8}\.[0-9]+$' \
    | head -n 1 \
    || true
}

release_notes() {
  local base_sha
  base_sha="$(gh api "repos/${upstream_repository}/commits/${base_tag}" --jq '.sha')"
  printf 'Fork build of [`%s`](https://github.com/%s/releases/tag/%s).\n\n' "$base_tag" "$upstream_repository" "$base_tag"
  printf 'Fork commits:\n\n%s\n' "$(
    gh api "repos/${fork_repository}/compare/${base_sha}...${ref}" \
      --jq '.commits[] | "- " + (.commit.message | split("\n")[0])'
  )"
}

resolve_release() {
  local draft status base_sha
  draft="$(gh release list --limit 100 --json tagName,isDraft --jq '[.[] | select(.isDraft)][0].tagName // empty')"
  if [[ -n "$draft" ]]; then
    tag="$draft"
    ref="$(gh release view "$tag" --json targetCommitish --jq '.targetCommitish')"
    version="${tag#v}"
    base_tag="v${version%???}"
    log "Using draft ${tag} at ${ref:0:9}"
    return
  fi

  checkout "$fork_branch"
  base_tag="$("$repo/fork/bin/latest-upstream-nightly")"
  base_sha="$(gh api "repos/${upstream_repository}/commits/${base_tag}" --jq '.sha')"
  ref="$(gh api "repos/${fork_repository}/commits/${fork_branch}" --jq '.sha')"
  status="$(gh api "repos/${fork_repository}/compare/${base_sha}...${ref}" --jq '.status')"
  if [[ "$status" != "ahead" && "$status" != "identical" ]]; then
    echo "${fork_branch} is not on ${base_tag} yet. Run: fork/bin/release sync" >&2
    exit 1
  fi

  local released
  released="$(released_tag_for "$ref")"
  if [[ -n "$released" ]]; then
    echo "${fork_branch} (${ref:0:9}) is already released as ${released}." >&2
    exit 0
  fi

  version="$("$repo/fork/bin/next-version" "$base_tag" "https://github.com/${fork_repository}.git")"
  tag="v${version}"
  log "Creating draft ${tag} at ${ref:0:9}"
  gh release create "$tag" --draft --prerelease --target "$ref" --title "T3 Code ${version}" --notes "$(release_notes)" >/dev/null
}

read_public_config() {
  sed -n "s/^$1=//p" "$repo/.env.example"
}

export_build_env() {
  export T3CODE_CLERK_PUBLISHABLE_KEY="$(read_public_config T3CODE_CLERK_PUBLISHABLE_KEY)"
  export T3CODE_CLERK_JWT_TEMPLATE="$(read_public_config T3CODE_CLERK_JWT_TEMPLATE)"
  export T3CODE_CLERK_CLI_OAUTH_CLIENT_ID="$(read_public_config T3CODE_CLERK_CLI_OAUTH_CLIENT_ID)"
  export T3CODE_RELAY_URL="$(read_public_config T3CODE_RELAY_URL)"
  export T3CODE_TELEMETRY_CHANNEL=dev
  export GITHUB_REPOSITORY="$fork_repository"
  export CI=true
}

build_bundle() {
  local rust_target="$1"
  log "Installing dependencies"
  vp install "${install_filters[@]}"
  node scripts/update-release-package-versions.ts "$version"
  log "Building the JS bundle"
  vp run build:desktop:bundle
  log "Building the resource monitor"
  cargo build --locked --release --manifest-path native/resource-monitor/Cargo.toml --target "$rust_target"
}

build_linux_in_container() {
  version="$1"
  cd "$repo"
  export_build_env
  build_bundle x86_64-unknown-linux-gnu

  log "Building the CLI archive"
  node scripts/apply-web-brand-assets.ts nightly apps/server/dist/client
  node apps/server/scripts/cli.ts build-exe --verbose
  local monitor_dir
  monitor_dir="$(mktemp -d)"
  rm -rf release-cli
  mkdir -p "$monitor_dir/linux-x64"
  cp native/resource-monitor/target/x86_64-unknown-linux-gnu/release/t3-resource-monitor "$monitor_dir/linux-x64/"
  node scripts/build-cli-archive.ts \
    --platform linux \
    --arch x64 \
    --version "$version" \
    --resource-monitor-dir "$monitor_dir" \
    --output-dir release-cli
  node scripts/smoke-cli-archive.ts --archive release-cli/* --expect-version "$version"

  log "Building the AppImage"
  T3CODE_DESKTOP_REUSE_RESOURCE_MONITOR=true vp run dist:desktop:artifact \
    --platform linux --target AppImage --arch x64 --build-version "$version" --skip-build --verbose
}

linux_image() {
  local node_version vite_plus_version dockerfile digest image
  node_version="$(jq -r '.engines.node' "$repo/package.json")"
  vite_plus_version="$(sed -nE 's/^  vite-plus: ([0-9][^ ]*)$/\1/p' "$repo/pnpm-workspace.yaml")"
  dockerfile="$repo/fork/linux-release.Dockerfile"
  digest="$(sha256sum < "$dockerfile" | cut -c1-12)"
  image="t3code-fork-release-linux:node${node_version}-vp${vite_plus_version}-${digest}"
  if ! docker image inspect "$image" >/dev/null 2>&1; then
    log "Building the Linux build image ${image}"
    docker build -t "$image" -f "$dockerfile" \
      --build-arg "NODE_VERSION=${node_version}" \
      --build-arg "VITE_PLUS_VERSION=${vite_plus_version}" \
      "$repo/fork" >&2
  fi
  printf '%s\n' "$image"
}

release_linux() {
  resolve_release
  checkout "$ref"
  local image cache="$work/linux-cache"
  image="$(linux_image)"
  mkdir -p "$cache/home" "$cache/cargo"
  docker run --rm \
    --user "$(id -u):$(id -g)" \
    --memory "${T3CODE_RELEASE_MEMORY:-8g}" \
    --cpus "${T3CODE_RELEASE_CPUS:-8}" \
    -e HOME=/cache/home \
    -e CARGO_HOME=/cache/cargo \
    -e T3CODE_RELEASE_WORK_DIR=/work \
    -v "$repo:/work/repo" \
    -v "$cache:/cache" \
    -w /work/repo \
    "$image" \
    bash fork/bin/release build-linux-in-container "$version"

  local assets="$work/assets-linux"
  rm -rf "$assets"
  mkdir -p "$assets"
  cp "$repo"/release/*.AppImage "$repo"/release/nightly-linux.yml "$repo"/release-cli/t3-*.tar.gz "$assets/"
  (cd "$assets" && sha256sum t3-*.tar.gz > SHA256SUMS)
  upload "$assets"/*
}

signing_identity() {
  if [[ -n "${FORK_SIGNING_IDENTITY:-}" ]]; then
    printf '%s\n' "$FORK_SIGNING_IDENTITY"
    return
  fi
  security find-identity -p codesigning \
    | sed -n "s/^ *[0-9]*) \([0-9A-F]\{40\}\) \"${signing_name}\".*/\1/p" \
    | head -n 1
}

release_mac() {
  local identity
  identity="$(signing_identity)"
  if [[ -z "$identity" ]]; then
    echo "No \"${signing_name}\" signing identity in the keychain." >&2
    exit 1
  fi

  resolve_release
  checkout "$ref"
  cd "$repo"
  export_build_env
  build_bundle aarch64-apple-darwin

  log "Building the macOS app"
  T3CODE_DESKTOP_REUSE_RESOURCE_MONITOR=true vp run dist:desktop:artifact \
    --platform mac --target dmg --arch arm64 --build-version "$version" --skip-build --verbose

  local assets="$work/assets-mac"
  rm -rf "$assets"
  mkdir -p "$assets"
  cp release/*-arm64.zip release/*-arm64.dmg release/nightly-mac.yml "$assets/"
  log "Signing with ${signing_name}"
  fork/bin/resign-mac "$assets" "$identity"
  upload "$assets"/*-arm64.zip "$assets"/*-arm64.dmg "$assets"/nightly-mac.yml
}

upload() {
  log "Uploading to ${tag}: $(printf '%s ' "${@##*/}")"
  gh release upload "$tag" "$@" --clobber
  publish_when_complete
}

publish_when_complete() {
  local names pattern name found
  names="$(gh release view "$tag" --json assets --jq '.assets[].name')"
  for pattern in "${required_assets[@]}"; do
    found=false
    while IFS= read -r name; do
      case "$name" in
        $pattern) found=true ;;
      esac
    done <<< "$names"
    if [[ "$found" == false ]]; then
      log "Draft ${tag} still needs ${pattern}. Run the other platform to publish it."
      return
    fi
  done

  log "Publishing ${tag}"
  gh release edit "$tag" --draft=false --prerelease >/dev/null
  "$repo/fork/bin/finish-release" "$version" "$keep_count"
  log "Published https://github.com/${fork_repository}/releases/tag/${tag}"
}

sync_branch() {
  checkout "$fork_branch"
  local base_tag before
  base_tag="$("$repo/fork/bin/latest-upstream-nightly")"
  git -C "$repo" fetch --no-tags origin "+refs/heads/${fork_branch}:refs/remotes/origin/${fork_branch}"
  git -C "$repo" fetch --no-tags "https://github.com/${upstream_repository}.git" "+refs/tags/${base_tag}:refs/tags/${base_tag}"
  before="$(git -C "$repo" rev-parse "refs/remotes/origin/${fork_branch}")"
  git -C "$repo" -c checkout.workers=0 checkout --quiet --force -B "$fork_branch" "$before"

  if git -C "$repo" merge-base --is-ancestor "$base_tag" HEAD; then
    log "${fork_branch} already contains ${base_tag}"
    return
  fi

  log "Rebasing ${fork_branch} onto ${base_tag}"
  if ! git -C "$repo" rebase "$base_tag"; then
    local conflicts
    conflicts="$(git -C "$repo" diff --name-only --diff-filter=U)"
    git -C "$repo" rebase --abort
    printf '\nRebase onto %s stopped on conflicts in:\n%s\n\nResolve them as FORK.md says, push %s, then run fork/bin/release sync again.\n' \
      "$base_tag" "$conflicts" "$fork_branch" >&2
    exit 1
  fi
  git -C "$repo" -c credential.helper= -c credential.helper='!gh auth git-credential' \
    push --force-with-lease="${fork_branch}:${before}" origin "HEAD:refs/heads/${fork_branch}"
  log "Pushed ${fork_branch} on ${base_tag}"
}

main() {
  case "${1:-}" in
    sync) sync_branch ;;
    linux) release_linux ;;
    mac) release_mac ;;
    build-linux-in-container) build_linux_in_container "${2:?version}" ;;
    *) usage ;;
  esac
}

main "$@"; exit
