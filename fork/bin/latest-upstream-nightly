#!/usr/bin/env bash
set -euo pipefail

upstream_repository="${UPSTREAM_REPOSITORY:-pingdotgg/t3code}"

latest_tag="$(
  gh api "repos/${upstream_repository}/releases?per_page=30" --jq '
    [.[]
      | select(.draft == false)
      | select(.tag_name | test("^v[0-9]+\\.[0-9]+\\.[0-9]+-nightly\\.[0-9]{8}\\.[0-9]+$"))]
    | sort_by(.published_at)
    | last
    | .tag_name // empty'
)"

if [[ -z "$latest_tag" ]]; then
  echo "No published nightly release found in ${upstream_repository}." >&2
  exit 1
fi

printf '%s\n' "$latest_tag"
