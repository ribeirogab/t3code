#!/usr/bin/env bash
set -euo pipefail

repository="$1"
tag="$2"
app_dir="$HOME/Applications"
app_path="${app_dir}/t3code-nightly.AppImage"
staging_dir="$(mktemp -d "${TMPDIR:-/tmp}/t3code-install.XXXXXX")"
trap 'rm -rf "$staging_dir"' EXIT

manifest_sha512() {
  awk -v name="$1" '
    $1 == "-" && $2 == "url:" { current = $3 }
    $1 == "sha512:" && current == name { print $2; exit }
  ' "$staging_dir/nightly-linux.yml"
}

file_sha512() {
  openssl dgst -sha512 -binary "$1" | base64 | tr -d '\n'
}

gh release download "$tag" --repo "$repository" --pattern '*-x86_64.AppImage' --pattern 'nightly-linux.yml' --dir "$staging_dir"
new_app="$(find "$staging_dir" -maxdepth 1 -name '*-x86_64.AppImage' -print -quit)"
expected_sha512="$(manifest_sha512 "$(basename "$new_app")")"
if [[ -z "$expected_sha512" || "$(file_sha512 "$new_app")" != "$expected_sha512" ]]; then
  echo "$(basename "$new_app") does not match the sha512 in nightly-linux.yml." >&2
  exit 1
fi

# A fixed name lets the in-app updater replace this same file.
mkdir -p "$app_dir"
install -m 755 "$new_app" "${app_path}.new"
mv -f "${app_path}.new" "$app_path"

echo "Installed ${tag} from ${repository} at ${app_path}."
echo "Restart T3 Code if it is running. The first start adds it to the app menu."
